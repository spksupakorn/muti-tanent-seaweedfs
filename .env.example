# Copy to .env and fill every value. Generate secrets with: openssl rand -hex 24
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ADMIN_ACCESS_KEY=
S3_ADMIN_SECRET_KEY=
SEAWEED_ADMIN_PASSWORD=
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
DB_BACKOFFICE_PASSWORD=
# Absolute path of the master key file. Keep it OUTSIDE this repo and outside every volume or backup.
# Create it with: mkdir -p ~/.filestore && openssl rand -base64 32 > ~/.filestore/master.key
MASTER_KEY_HOST_FILE=
